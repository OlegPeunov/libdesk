{
  "name": "libdesk",
  "version": "0.1.0",
  "private": true,
  "description": "LibDesk: a minimal Next.js and Payload application",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^11.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "test:loans": "payload run tests/loans.integration.ts",
    "test:access": "payload run tests/access.integration.ts",
    "test:media": "payload run tests/media.integration.ts",
    "test:media:unavailable": "payload run tests/media.integration.ts unavailable",
    "test:inline": "payload run tests/inline.integration.ts",
    "test": "pnpm test:loans && pnpm test:access && pnpm test:media && pnpm test:media:unavailable && pnpm test:inline"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.14.2",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.7.3"
  }
}
