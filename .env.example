# Use a dedicated development PostgreSQL database, never production.
# Paste its PostgreSQL connection URL here. Preserve the provider's TLS options.
DATABASE_URL=

# Generate a random secret locally, for example: openssl rand -hex 32
PAYLOAD_SECRET=

# Local application origin; this is not a secret.
SERVER_URL=http://localhost:3000

# Private Cloudflare R2 bucket, accessed by the Node.js S3 adapter.
# Endpoint is the HTTPS S3 service origin, without a bucket path or public domain.
# Use credentials scoped to this bucket with object read/write/delete permissions.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional AI field help. Keep this key server-side; never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Optional free model slug. Empty defaults to openrouter/free; no paid fallback.
# For consistent model selection, set a verified available explicit :free model.
OPENROUTER_MODEL=
